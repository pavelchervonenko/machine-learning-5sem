# -------------------------
# Python virtual environments
# -------------------------
venv/
.venv/
env/
ENV/
*.env

# -------------------------
# Python cache
# -------------------------
__pycache__/
*.pyc
*.pyo
*.pyd
*.pdb
*.pkl
*.sqlite3

# Cython generated files
*.c
*.cpp

# -------------------------
# Jupyter Notebook
# -------------------------
.ipynb_checkpoints/
.jupyter/
*.ipynb_convert/

# Avoid saving large cell outputs
**/*.ipynb

# Allow ONLY specific notebooks (remove '#' below if needed)
# !notebooks/*.ipynb

# -------------------------
# VSCode
# -------------------------
.vscode/
.history/
*.code-workspace

# -------------------------
# System files
# -------------------------
.DS_Store
Thumbs.db

# -------------------------
# Logs
# -------------------------
*.log

# -------------------------
# Backup files
# -------------------------
*.bak
*.tmp
*.swp
*.swo

# -------------------------
# Build / distribution
# -------------------------
build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/

# -------------------------
# Environment variables
# -------------------------
*.secret
*.key
*.json.secret
*.local

# -------------------------
# Plotly / Matplotlib caches
# -------------------------
*.png
*.svg
.ipynb_checkpoints
.cache/
